# Copy to .env and adjust. Every variable is optional unless noted.

NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Browser origins allowed to open the WebSocket (comma separated).
# Leave empty to only allow same-origin connections.
ALLOWED_ORIGINS=https://meet.example.com

# Number of reverse proxies in front of the app (e.g. 1 for nginx/Caddy/ALB).
# Must match reality: too high lets clients spoof their IP, too low makes all
# users share the proxy's IP for rate limits and bans.
TRUST_PROXY_HOPS=1

# --- ICE / TURN -------------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302
# Strongly recommended in production: users behind strict NATs/firewalls cannot connect without TURN.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# Same value as coturn's static-auth-secret. Generate with: openssl rand -hex 32
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
# "relay" hides users' IP addresses from each other (all media via TURN).
ICE_TRANSPORT_POLICY=all

# --- Abuse protection ---------------------------------------------------------
# Optional: stable secret so bans survive restarts. Random per process if unset.
IP_HASH_SECRET=
MAX_CONNECTIONS_PER_IP=4
MAX_CONNECTION_ATTEMPTS_PER_MINUTE=30
MAX_TOTAL_CONNECTIONS=10000
REPORT_BAN_THRESHOLD=3
REPORT_WINDOW_MS=900000
BAN_DURATION_MS=3600000

# --- Matchmaking ----------------------------------------------------------------
INTEREST_MATCH_TIMEOUT_MS=10000
REMATCH_COOLDOWN_MS=60000

# --- docker-compose only (coturn) ------------------------------------------------
TURN_REALM=meet.example.com
# Public IP address of the TURN host.
TURN_EXTERNAL_IP=203.0.113.10
